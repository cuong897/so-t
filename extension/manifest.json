{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Soát — kiểm tra chính tả tiếng Việt",
  "version": "1.0.0",
  "description": "Sửa lỗi dấu tiếng Việt ngay khi bạn gõ: thiếu dấu, sai dấu, hỏi/ngã. Chạy trên máy bạn, không gửi dữ liệu đi.",

  "permissions": ["storage", "activeTab", "offscreen"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "web_accessible_resources": [
    {
      "resources": ["src/engine/*.js", "src/content/*.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Soát"
  },

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
