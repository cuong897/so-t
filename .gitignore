node_modules/
# ml/data/* chứ không phải ml/data/: loại cả THƯ MỤC thì không phủ định lại
# được file nào bên trong — git không bước vào đó nữa.
ml/data/*
# Mấy file cấu hình bé định nghĩa cách sinh nhiễu thì PHẢI version: chúng là
# đầu vào của công thức dựng lại dữ liệu ghi trong docs/decisions.md, mà trước
# đây không file nào được theo dõi — tức những công thức đó không chạy lại được
# trên một máy trắng. Tổng cộng 45KB.
!ml/data/class_weights*.json
!ml/data/propensity.json
ml/out/

# Sinh ra bởi ml/export_tokenizer.py và ml/export_onnx.py — không commit,
# vì chúng là artifact phái sinh và tokenizer.json nặng 2.5MB.
extension/models/*.onnx
extension/models/*.onnx.data
extension/models/tokenizer.json
extension/models/lexicon.json
extension/models/*.meta.json
extension/models/*.report.json
extension/vendor/
__pycache__/
*.pyc
.venv/

# onnxruntime-web đóng gói kèm (14MB) — tải bằng ml/fetch_vendor.sh
extension/vendor/

# Artifact đóng gói: zip 50MB + ảnh chụp, sinh lại được bằng
# ml/package_extension.py và ml/make_screenshots.py
dist/
# Sinh bởi make_screenshots.py từ popup.html thật
dev/popup-demo.html

# Mọi tập dữ liệu sinh ra — dựng lại bằng ml/dataset.py và ml/mix_datasets.py.
# Mẫu bao trùm ml/data_* chứ không liệt kê từng thư mục: lần trước liệt kê tay
# thì data_dgir/ lọt lưới, và một blob 311MB đã từng lọt lưới đúng theo cách đó.
ml/data_*/

# Cấu hình công cụ chạy thử ở máy local, không liên quan tới sản phẩm
.claude/
